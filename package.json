{
  "name": "open-calc-studio",
  "private": true,
  "version": "2026.44.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "node scripts/embed-sync.mjs && vite build -c vite.lib.config.ts && vite build -c vite.frame.config.ts && node scripts/embed-sync.mjs post",
    "pack:lib": "npm run build:lib && node -e \"require('node:fs').mkdirSync('release-embed', { recursive: true })\" && cd packages/embed && npm pack --pack-destination ../../release-embed",
    "dev:embed": "node packages/embed/copy-assets.mjs packages/embed/example/public/calc-studio && vite -c packages/embed/example/vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:lib:browser": "npm run build:lib && playwright test -c playwright.library.config.ts",
    "generate:mcp-actions": "node scripts/generate-mcp-actions.mjs",
    "convert:budget": "node scripts/convert-budget.mjs",
    "build:platform": "vite build --mode platform",
    "version:check": "node scripts/version.mjs check",
    "version:next": "node scripts/version.mjs next",
    "test:version": "node --test scripts/version.node-test.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node dist-server/server.mjs",
    "test:server": "npm run build:server && node --test server/api.node-test.mjs",
    "check:blueprint": "node scripts/verify-blueprint.mjs",
    "test:bundle": "node --test scripts/prepare-universal-binaries.node-test.mjs",
    "test:signing": "node --test scripts/ci/sign-linux.node-test.mjs"
  },
  "dependencies": {
    "@ifc-lite/geometry": "^7.6.0",
    "@ifc-lite/parser": "^9.1.0",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@thatopen/components": "^3.4.1",
    "@thatopen/components-front": "^3.4.1",
    "@thatopen/fragments": "^3.4.1",
    "@types/three": "^0.184.0",
    "7z-wasm": "^1.2.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "mdb-reader": "^3.2.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "sql.js": "^1.14.1",
    "stream-browserify": "^3.0.0",
    "three": "^0.184.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.27.7",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.0"
  },
  "license": "LGPL-3.0-only"
}
